VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AI_INTAKE_BACKEND_URL=/api/analyze-item

# Set to "waitlist" in the public Vercel Production environment before launch.
# It hides account creation and sign-in from the landing page. Redeploy after changing it.
VITE_PROOFVAULT_LAUNCH_MODE=

# Server-side only. Configure these in Vercel project env vars when you are ready
# for live AI photo analysis. Do not prefix them with VITE_ and do not expose them
# in the browser or mobile app.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash
# Optional capacity fallback. Keep this server-side too; do not use a VITE_ prefix.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Later production switch option.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=

# Server-side only. Required for the public early-access waitlist endpoint.
# Never prefix this with VITE_ or place it in browser code.
SUPABASE_SERVICE_ROLE_KEY=
